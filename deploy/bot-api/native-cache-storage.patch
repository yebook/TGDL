+namespace {
+struct TgdCacheUsage final : td::Jsonable {
+  const CacheStorage &state;
+  explicit TgdCacheUsage(const CacheStorage &snapshot) : state(snapshot) {}
+  void store(td::JsonValueScope *scope) const {
+    auto usage = scope->enter_object();
+    usage("used_bytes", state.used_bytes);
+    usage("file_count", state.file_count);
+  }
+};
+struct TgdCacheOperation final : td::Jsonable {
+  const CacheStorage &state;
+  explicit TgdCacheOperation(const CacheStorage &snapshot) : state(snapshot) {}
+  void store(td::JsonValueScope *scope) const {
+    auto operation = scope->enter_object();
+    operation("operation_id", state.operation_id);
+    operation("state", state.operation == CacheStorage::Operation::Running ? "running" :
+                       state.operation == CacheStorage::Operation::Succeeded ? "succeeded" : "failed");
+    if (state.has_before) operation("before_bytes", state.before_bytes);
+    else operation("before_bytes", td::JsonNull());
+    if (state.has_after) {
+      operation("after_bytes", state.after_bytes);
+      operation("released_bytes", state.released_bytes);
+    } else {
+      operation("after_bytes", td::JsonNull());
+      operation("released_bytes", td::JsonNull());
+    }
+    if (state.error_code) operation("error_code", state.error_code);
+    else operation("error_code", td::JsonNull());
+  }
+};
+struct TgdCacheStorageReply final : td::Jsonable {
+  td::string generation;
+  const CacheStorage &state;
+  TgdCacheStorageReply(td::string value, const CacheStorage &snapshot)
+      : generation(std::move(value)), state(snapshot) {}
+  void store(td::JsonValueScope *scope) const {
+    auto o = scope->enter_object();
+    o("generation", generation);
+    o("scope", "current_bot");
+    const char *scan = "idle";
+    switch (state.scan) {
+      case CacheStorage::Scan::Idle: break;
+      case CacheStorage::Scan::Running: scan = "running"; break;
+      case CacheStorage::Scan::Ready: scan = "ready"; break;
+      case CacheStorage::Scan::Failed: scan = "failed"; break;
+    }
+    o("scan_state", scan);
+    if (state.has_usage) {
+      o("usage", TgdCacheUsage(state));
+    } else {
+      o("usage", td::JsonNull());
+    }
+    if (state.operation == CacheStorage::Operation::None) {
+      o("operation", td::JsonNull());
+    } else {
+      o("operation", TgdCacheOperation(state));
+    }
+  }
+};
+}
