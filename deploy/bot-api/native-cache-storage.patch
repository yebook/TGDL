+bool Client::tgd_cache_native_busy() const {
+  return tgd_cache_gate_.busy() || tgd_cache_storage_.has_active_files() ||
+         tgd_pending_requests_ != 0 || !cmd_queue_.empty() ||
+         !file_download_listeners_.empty() || !download_started_file_ids_.empty() ||
+         !pending_send_message_queries_.empty() || !yet_unsent_messages_.empty() || !yet_unsent_stories_.empty();
+}
+
+void Client::tgd_cache_storage_reply(PromisedQueryPtr query) {
+  TgdCacheStorageReply reply(query->arg("generation").str(), tgd_cache_storage_);
+  answer_query(reply, std::move(query));
+}
+
+void Client::tgd_cache_storage(PromisedQueryPtr query) {
+  const char *generation = std::getenv("TGD_PROGRESS_GENERATION");
+  if (!parameters_->local_mode_ || !was_authorized_ || closing_ || logging_out_ ||
+      !generation || !*generation || td::Slice(generation).size() > 128) {
+    return fail_query(404, "Not Found: cache storage unavailable", std::move(query));
+  }
+  auto expected_generation = query->arg("generation");
+  if (expected_generation.empty() || expected_generation.size() > 128 || !query->files().empty()) {
+    return fail_query(400, "Bad Request: invalid cache storage request", std::move(query));
+  }
+  if (expected_generation != td::Slice(generation)) {
+    return fail_query(409, "Conflict: cache generation changed", std::move(query));
+  }
+  if (query->method() == "tgdgetcachestorage") {
+    auto refresh = query->arg("refresh");
+    if (refresh != "0" && refresh != "1") {
+      return fail_query(400, "Bad Request: invalid cache storage request", std::move(query));
+    }
+    if (refresh == "1" && !tgd_cache_storage_.busy()) {
+      if (tgd_cache_native_busy()) {
+        return fail_query(409, "Conflict: TGD_CACHE_STORAGE_BUSY", std::move(query));
+      }
+      CHECK(tgd_cache_storage_.begin_scan());
+      send_request(make_object<td_api::getStorageStatistics>(0),
+                   td::make_unique<TdOnCacheStorageCallback>(this, 0));
+    }
+    return tgd_cache_storage_reply(std::move(query));
+  }
+  auto operation_id = query->arg("operation_id").str();
+  if (!CacheStorage::valid_operation_id(operation_id)) {
+    return fail_query(400, "Bad Request: invalid cache storage request", std::move(query));
+  }
+  auto admission = tgd_cache_storage_.begin_operation(operation_id, tgd_cache_native_busy());
+  if (admission == CacheStorage::Admission::Busy) {
+    // This exact response guarantees this ID has never been accepted.
+    return fail_query(409, "Conflict: TGD_CACHE_STORAGE_BUSY", std::move(query));
+  }
+  if (admission == CacheStorage::Admission::Accepted) {
+    send_request(make_object<td_api::getStorageStatistics>(0),
+                 td::make_unique<TdOnCacheStorageCallback>(this, 1));
+  }
+  tgd_cache_storage_reply(std::move(query));
+}
+
+void Client::tgd_cache_storage_result(int stage, object_ptr<td_api::Object> result) {
+  if (stage == 2) {
+    if (result->get_id() != td_api::storageStatistics::ID || closing_ || logging_out_) {
+      // A cancellation response may precede worker termination. Retain exclusion
+      // and expose uncertainty until this child generation is replaced.
+      return tgd_cache_storage_.failed(true);
+    }
+    // Never report TDLib's removed_stats: unlink failure is only logged there.
+    tgd_cache_storage_.scan = CacheStorage::Scan::Running;
+    send_request(make_object<td_api::getStorageStatistics>(0),
+                 td::make_unique<TdOnCacheStorageCallback>(this, 3));
+    return;
+  }
+  if (result->get_id() != td_api::storageStatistics::ID || closing_ || logging_out_) {
+    return tgd_cache_storage_.failed(false);
+  }
+  auto stats = move_object_as<td_api::storageStatistics>(result);
+  if (stats->size_ < 0 || stats->count_ < 0) return tgd_cache_storage_.failed(false);
+  if (stage == 0) return tgd_cache_storage_.scanned(stats->size_, stats->count_);
+  if (stage == 3) return tgd_cache_storage_.succeeded(stats->size_, stats->count_);
+  CHECK(stage == 1);
+  tgd_cache_storage_.before_scanned(stats->size_, stats->count_);
+  if (tgd_cache_native_busy()) return tgd_cache_storage_.failed(false);
+  send_request(make_object<td_api::optimizeStorage>(0, 0, 0, 0,
+                   td::vector<object_ptr<td_api::FileType>>(), td::vector<int64>(), td::vector<int64>(), false, 0),
+               td::make_unique<TdOnCacheStorageCallback>(this, 2));
+}
