+namespace {
+struct TgdProgressItem final : td::Jsonable {
+  td::string alias;
+  bool available = false;
+  ProgressCache::Snapshot snapshot;
+  void store(td::JsonValueScope *scope) const {
+    auto o = scope->enter_object();
+    o("file_id", alias);
+    o("available", td::JsonBool(available));
+    if (!available) return;
+    o("downloaded_bytes", td::max<std::int64_t>(0, snapshot.downloaded));
+    if (snapshot.size > 0) o("total_bytes", snapshot.size);
+    else if (snapshot.expected > 0) o("total_bytes", snapshot.expected);
+    else o("total_bytes", td::JsonNull());
+    o("total_kind", snapshot.size > 0 ? "exact" : snapshot.expected > 0 ? "estimated" : "unknown");
+    o("active", td::JsonBool(snapshot.active));
+    o("completed", td::JsonBool(snapshot.completed));
+  }
+};
+struct TgdProgressReply final : td::Jsonable {
+  td::string generation;
+  td::vector<TgdProgressItem> items;
+  void store(td::JsonValueScope *scope) const {
+    auto o = scope->enter_object();
+    o("generation", generation);
+    o("files", td::json_array(items, [](const TgdProgressItem &item) -> const TgdProgressItem & { return item; }));
+  }
+};
