+
+void Client::tgd_read_progress(PromisedQueryPtr query) {
+  const char *generation = std::getenv("TGD_PROGRESS_GENERATION");
+  if (!parameters_->local_mode_ || !was_authorized_ || closing_ || logging_out_ ||
+      !generation || !*generation || td::Slice(generation).size() > 128) {
+    return fail_query(404, "Not Found: progress unavailable", std::move(query));
+  }
+  auto input = query->arg("file_ids");
+  if (input.empty() || input.size() > 81920 || !query->files().empty()) {
+    return fail_query(400, "Bad Request: invalid progress batch", std::move(query));
+  }
+  auto parsed = json_decode(input);
+  if (parsed.is_error() || parsed.ok().type() != td::JsonValue::Type::Array ||
+      parsed.ok().get_array().empty() || parsed.ok().get_array().size() > 16) {
+    return fail_query(400, "Bad Request: invalid progress batch", std::move(query));
+  }
+  TgdProgressReply reply;
+  reply.generation = generation;
+  for (const auto &value : parsed.ok().get_array()) {
+    if (value.type() != td::JsonValue::Type::String || value.get_string().empty() || value.get_string().size() > 4096) {
+      return fail_query(400, "Bad Request: invalid progress alias", std::move(query));
+    }
+    TgdProgressItem item;
+    item.alias = value.get_string().str();
+    auto snapshot = tgd_progress_.find(item.alias, td::Time::now());
+    if (snapshot) { item.available = true; item.snapshot = *snapshot; }
+    reply.items.push_back(std::move(item));
+  }
+  answer_query(reply, std::move(query));
+}
