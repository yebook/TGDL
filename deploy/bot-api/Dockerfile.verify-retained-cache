ARG TGDL_BUILD_IMAGE=tgd-storage-cache-native-build
ARG TGDL_NATIVE_IMAGE=tgd-storage-cache-native
FROM ${TGDL_BUILD_IMAGE} AS fixture
COPY deploy/bot-api/prepare-acquisition-fixture.py deploy/bot-api/prepare-download-stop-fixture.py deploy/bot-api/prepare-cache-live-fixture.py deploy/bot-api/prepare-retained-cache-fixture.py /verification/
RUN python3 /verification/prepare-acquisition-fixture.py && python3 /verification/prepare-download-stop-fixture.py && python3 /verification/prepare-cache-live-fixture.py && python3 /verification/prepare-retained-cache-fixture.py && cmake --build /src/build --parallel 4 && cp /src/build/telegram-bot-api /verification/acquisition-fixture
FROM ${TGDL_NATIVE_IMAGE}
RUN apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends strace && rm -rf /var/lib/apt/lists/*
COPY --from=fixture /verification/acquisition-fixture /verification/
COPY deploy/bot-api/verify-native-transport.py deploy/bot-api/verify-native-cache-storage.py deploy/bot-api/verify-native-acquisition.py deploy/bot-api/verify-native-retained-cache.py /verification/
USER 1000:1000
ENTRYPOINT ["python3", "/verification/verify-native-retained-cache.py"]
