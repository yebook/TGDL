# Disposable verification image: never deployed by Compose.
ARG TGDL_API_IMAGE=tgd-bot-api-source:0.1.0
FROM ${TGDL_API_IMAGE}
USER root
RUN apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends strace g++ && rm -rf /var/lib/apt/lists/*
COPY deploy/bot-api/ProgressCache.h deploy/bot-api/test-progress-cache.cpp /verification/
RUN g++ -std=c++17 -Wall -Wextra -Werror /verification/test-progress-cache.cpp -o /verification/test-progress-cache && /verification/test-progress-cache
COPY deploy/bot-api/verify-native-transport.py /verification/verify-native-transport.py
COPY deploy/bot-api/verify-native-progress.py /verification/verify-native-progress.py
ENTRYPOINT ["python3", "/verification/verify-native-progress.py"]
