+void Client::tgd_retained_cache(PromisedQueryPtr query) {
+  const char *generation = std::getenv("TGD_PROGRESS_GENERATION");
+  if (!parameters_->local_mode_ || !was_authorized_ || closing_ || logging_out_ || !generation || !*generation)
+    return fail_query(404, "Not Found: cache cleanup unavailable", std::move(query));
+  auto alias = query->arg("file_id");
+  auto expected = query->arg("generation");
+  auto path = query->arg("expected_path");
+  auto identity = query->arg("expected_identity");
+  auto size = td::to_integer_safe<int64>(query->arg("expected_size"));
+  bool proof = query->has_arg("expected_path") || query->has_arg("expected_size") || query->has_arg("expected_identity");
+  bool deleting = query->method() == "tgddeletepartialfilecache";
+  bool owner = query->has_arg("acquisition_id");
+  const size_t count = 2 + (proof ? 3 : 0) + (owner ? 1 : 0);
+  if (alias.empty() || alias.size() > 4096 || expected.empty() || expected.size() > 128 ||
+      !query->files().empty() || query->args().size() != count ||
+      (deleting && (!proof || owner)) ||
+      (proof && (path.empty() || path.size() > 4096 || path[0] != '/' || path.find('\0') != td::Slice::npos ||
+                 size.is_error() || size.ok() < 0 || query->arg("expected_size").size() > 20 || identity.size() != 64 ||
+                 identity.str().find_first_not_of("0123456789abcdef") != td::string::npos)))
+    return fail_query(400, "Bad Request: invalid cache cleanup request", std::move(query));
+  if (expected != td::Slice(generation))
+    return fail_query(409, "Conflict: cache generation changed", std::move(query));
+  tgd_acquisitions_.prune(td::Time::now());
+  if (owner) {
+    auto *registered = tgd_acquisitions_.get(query->arg("acquisition_id").str());
+    if (!registered || registered->alias != alias.str())
+      return fail_query(409, "Conflict: cache identity unavailable", std::move(query));
+  }
+  if (tgd_cache_gate_.busy() || tgd_cache_storage_.mutation_busy() ||
+      (deleting && (tgd_cache_storage_.busy() || tgd_cache_native_busy())))
+    return fail_query(409, "Conflict: cache cleanup busy", std::move(query));
+  if (deleting && !tgd_cache_gate_.begin_resolution())
+    return fail_query(409, "Conflict: cache cleanup busy", std::move(query));
+  send_request(make_object<td_api::getRemoteFile>(alias.str(), nullptr),
+               td::make_unique<TdOnRetainedCacheCallback>(this, std::move(query), 0));
+}
