+void FileManager::tgd_delete_partial_file_cache(FileId alias, string path, int64 size, string identity,
+                                               Promise<Unit> promise) {
+  TRY_STATUS_PROMISE(promise, G()->close_status());
+  auto node = get_sync_file_node(alias);
+  if (!node || !tgd_cache_node_idle(node)) return promise.set_error(409, "TGD_CACHE_RECOVERY_BUSY");
+  auto state = tgd_get_file_cache(alias, path, size, identity);
+  if (!state->settled_) return promise.set_error(409, "TGD_CACHE_RECOVERY_BUSY");
+  if (state->completeness_ == "absent") return promise.set_value(Unit());
+  if (state->completeness_ != "partial" || state->path_ != path || state->size_ != size || state->identity_ != identity)
+    return promise.set_error(409, "TGD_CACHE_RECOVERY_IDENTITY");
+  auto proof = TgdCacheProof::open(get_files_temp_dir(FileView(node).get_type()), path, size);
+  if (!proof || tgd_cache_fingerprint(*proof, node->get_unique_file_id()) != identity)
+    return promise.set_error(409, "TGD_CACHE_RECOVERY_IDENTITY");
+  // Check every node, not only this alias: merges/aliases must never let an idle
+  // remote delete a different active writer's partial pathname.
+  if (file_nodes_.size() > 65536) return promise.set_error(409, "TGD_CACHE_RECOVERY_BUSY");
+  for (size_t i = 0; i < file_nodes_.size(); ++i) {
+    auto other = file_nodes_[i].get();
+    if (other && other->local_.type() != LocalFileLocation::Type::Empty && other->local_.file_name() == path &&
+        !tgd_cache_node_idle(FileNodePtr(other->main_file_id_, this))) return promise.set_error(409, "TGD_CACHE_RECOVERY_BUSY");
+  }
+  if (node->local_.type() == LocalFileLocation::Type::Partial)
+    return delete_file_with_proof(alias, std::move(promise), "tgd_partial_cache", std::move(proof));
+  // Restart or previous failed unlink: no local association exists. The exact
+  // native proof remains scoped to this remote and current Bot's temp directory.
+  send_closure(file_load_manager_, &FileLoadManager::tgd_unlink_file, path, std::move(promise), std::move(proof));
 }
 
