+      if (result->get_id() == td_api::error::ID &&
+          static_cast<td_api::error *>(result.get())->message_ == "TGD_CACHE_RECOVERY_BUSY")
+        return fail_query(409, "Conflict: cache file busy", std::move(query));
+      if (result->get_id() == td_api::error::ID &&
+          static_cast<td_api::error *>(result.get())->message_ == "TGD_CACHE_RECOVERY_IDENTITY")
+        return fail_query(409, "Conflict: cache identity changed", std::move(query));
+      return fail_query(500, "Internal Server Error: cache removal unconfirmed", std::move(query));
+    }
+    if (!cache_path_absent(query->arg("expected_path").str()))
+      return fail_query(500, "Internal Server Error: cache removal unconfirmed", std::move(query));
+    TgdCacheReply reply;
+    reply.generation = query->arg("generation").str();
+    reply.status = "deleted";
+    return answer_query(reply, std::move(query));
+  }
+  if (closing_ || logging_out_ || result->get_id() == td_api::error::ID) {
+    if (deleting) tgd_cache_gate_.resolved();
+    return fail_query(409, "Conflict: cache identity unavailable", std::move(query));
+  }
+  if (stage == 0) {
+    CHECK(result->get_id() == td_api::file::ID);
+    auto file = move_object_as<td_api::file>(result);
+    auto path = query->arg("expected_path").str();
+    auto size_arg = query->arg("expected_size");
+    auto size = size_arg.empty() ? 0 : td::to_integer_safe<int64>(size_arg).ok();
+    auto identity = query->arg("expected_identity").str();
+    if (deleting) {
+      send_request(make_object<td_api::tgdDeletePartialFileCache>(file->id_, path, size, identity),
+                   td::make_unique<TdOnRetainedCacheCallback>(this, std::move(query), 2));
