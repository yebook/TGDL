+td_api::object_ptr<td_api::tgdFileCacheSnapshot> FileManager::tgd_get_file_cache(
+                               FileId alias, const string &expected_path, int64 expected_size,
+                               const string &expected_identity) {
+  auto out = td_api::make_object<td_api::tgdFileCacheSnapshot>("unknown", "", 0, 0, "", false,
+                                                             "cache_unavailable", false);
+  auto node = get_sync_file_node(alias);
+  if (!node || !FileView(node).has_full_remote_location()) return out;
+  const auto type = FileView(node).get_type();
+  const auto kind = get_file_type_class(type);
+  if (kind == FileTypeClass::Temp || kind == FileTypeClass::Encrypted || kind == FileTypeClass::Secure ||
+      type == FileType::None || type == FileType::Size) return out;
+  out->settled_ = tgd_cache_node_idle(node);
+  string path, root;
+  bool orphan = false, partial = false;
+  if (node->local_.type() == LocalFileLocation::Type::Full) {
+    path = node->local_.full().path_;
+    root = get_files_dir(type);
+  } else if (node->local_.type() == LocalFileLocation::Type::Partial) {
+    partial = true;
+    path = node->local_.partial().path_;
+    root = get_files_temp_dir(type);
+  } else if (!expected_path.empty()) {
+    orphan = partial = true;
+    path = expected_path;
+    root = get_files_temp_dir(type);
+  } else {
+    out->completeness_ = "absent";
+    out->reason_ = "cache_missing";
+    return out;
+  }
+  // No directory scans, links, arbitrary ancestors or media registration. A
+  // retained exact native proof alone may identify a partial orphan after restart.
+  struct stat named{};
+  if (::lstat(path.c_str(), &named) != 0) {
+    if (errno == ENOENT) { out->completeness_ = "absent"; out->reason_ = "cache_missing"; }
+    return out;
+  }
+  auto proof = TgdCacheProof::open(root, path, named.st_size);
+  if (!proof) { out->reason_ = "cache_identity_changed"; return out; }
+  const auto identity = tgd_cache_fingerprint(*proof, node->get_unique_file_id());
+  if ((!expected_path.empty() && (path != expected_path || named.st_size != expected_size ||
+                                  identity != expected_identity)) || !proof->matches()) {
+    out->reason_ = "cache_identity_changed";
+    return out;
+  }
+  out->completeness_ = partial ? "partial" : "complete";
+  out->path_ = path;
+  out->size_ = named.st_size;
+  out->allocated_bytes_ = static_cast<int64>(named.st_blocks) * 512;
+  out->identity_ = identity;
+  out->reason_ = out->settled_ ? (partial ? "bitmap_unavailable" : "cache_complete") : "cache_busy";
+  if (partial && !orphan && out->settled_) {
+    const auto &location = node->local_.partial();
+    // Never treat sparse length or progress alone as reusable downloaded data.
+    if (location.part_size_ > 0 && !location.ready_bitmask_.empty() && location.ready_size_ > 0 &&
+        Bitmask(Bitmask::Decode{}, location.ready_bitmask_).get_total_size(location.part_size_,
+                            node->expected_size(true)) == location.ready_size_ &&
+        location.ready_size_ <= named.st_size) {
+      out->resumable_ = true;
+      out->reason_ = "resume_available";
+    }
+  }
+  return out;
+}
