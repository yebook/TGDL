+namespace {
+string tgd_cache_fingerprint(const TgdCacheProof &proof, const string &remote) {
+  const auto &st = proof.identity;
+  string value = remote + ":" + proof.path;
+  for (auto part : {static_cast<long long>(st.st_dev), static_cast<long long>(st.st_ino),
+                    static_cast<long long>(st.st_size), static_cast<long long>(st.st_mode),
+                    static_cast<long long>(st.st_mtim.tv_sec), static_cast<long long>(st.st_mtim.tv_nsec),
+                    static_cast<long long>(st.st_ctim.tv_sec), static_cast<long long>(st.st_ctim.tv_nsec)})
+    value += ":" + std::to_string(part);
+  return hex_encode(sha256(value));
+}
