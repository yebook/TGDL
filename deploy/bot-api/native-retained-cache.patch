+    }
+    return;
+  }
+  if (tgd_cache_gate_.busy() || tgd_cache_storage_.mutation_busy())
+    return fail_query(409, "Conflict: cache cleanup busy", std::move(query));
+  CHECK(result->get_id() == td_api::tgdFileCacheSnapshot::ID);
+  TgdRetainedCacheReply reply;
+  reply.generation = query->arg("generation").str();
+  reply.cache = move_object_as<td_api::tgdFileCacheSnapshot>(result);
+  if (query->has_arg("acquisition_id")) {
+    auto *registered = tgd_acquisitions_.get(query->arg("acquisition_id").str());
+    if (!registered || !registered->settled) {
+      reply.cache->settled_ = false;
+      reply.cache->resumable_ = false;
+      reply.cache->reason_ = "cache_busy";
+    }
+  }
+  answer_query(reply, std::move(query));
+}
