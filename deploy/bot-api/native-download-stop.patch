+bool FileManager::tgd_has_download_worker(FileNodePtr node, bool include_current) const {
+  for (const auto &entry : tgd_download_workers_) {
+    if ((!include_current && node->download_priority_ > 0 && entry.first == node->download_id_)) {
+      continue;  // A shared surviving consumer owns this current writer.
+    }
+    if (get_file_node(entry.second).get() == node.get()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void FileManager::cancel_download_and_wait(FileId file_id,
+                                         Promise<td_api::object_ptr<td_api::file>> promise) {
+  TRY_STATUS_PROMISE(promise, G()->close_status());
+  auto node = get_sync_file_node(file_id);
+  if (!node) {
+    return promise.set_error(400, "Unknown file ID");
+  }
+  if (tgd_download_stop_waiters_.size() >= 128) {
+    return promise.set_error(429, "Too many download stop waiters");
+  }
+  const bool had_generator = node->generate_ != nullptr || node->generate_id_ != 0;
+  cancel_download(file_id, 0, false);
+  // Bot API remote media uses FileDownloader. A generated-file actor has a
+  // different writer lifetime and must never be reported stopped by this gate.
+  if (had_generator) {
+    return promise.set_error(409, "Generated file stop proof unavailable");
+  }
+  tgd_download_stop_waiters_.push_back({file_id, std::move(promise)});
+  tgd_finish_download_stops();
+}
+
+void FileManager::tgd_finish_download_stops() {
+  for (size_t i = 0; i < tgd_download_stop_waiters_.size();) {
+    auto &waiter = tgd_download_stop_waiters_[i];
+    auto node = get_file_node(waiter.file_id);
+    if (!node || node->generate_id_ != 0 || tgd_has_download_worker(node, false)) {
+      ++i;
+      continue;
+    }
+    // No user request can be re-admitted by this completion. Client's per-file
+    // gate remains held until it consumes this token-specific authoritative reply.
+    waiter.promise.set_value(get_file_object(waiter.file_id));
+    tgd_download_stop_waiters_.erase(tgd_download_stop_waiters_.begin() + i);
+  }
+}
+
+void FileManager::on_download_worker_stopped(FileDownloadManager::QueryId query_id) {
+  auto it = tgd_download_workers_.find(query_id);
+  CHECK(it != tgd_download_workers_.end());
+  auto file_id = it->second;
+  tgd_download_workers_.erase(it);
+  // The manager posted ordinary completion/error first. Do not consume a
+  // download query here: that would let a stale lifetime event touch a retry.
+  CHECK(download_queries_.get(query_id) == nullptr);
+  auto node = get_file_node(file_id);
+  if (node) {
+    run_download(node, false);  // Resume a deferred internal/other-alias owner.
+  }
+  tgd_finish_download_stops();
+}
