+void FileDownloadManager::on_worker_destroyed(QueryId query_id) {
+  CHECK(live_workers_.erase(query_id) == 1);
+  auto it = query_id_to_node_id_.find(query_id);
+  if (it != query_id_to_node_id_.end()) {
+    on_error_impl(it->second, Status::Error(-1, "Canceled"));
+  }
+  // Final result/error was posted to FileManager before close_node requested
+  // destruction. Same-sender actor message ordering drains that bookkeeping
+  // before FileManager receives this separate physical-stop notification.
+  if (!stop_flag_) {
+    callback_->on_worker_stopped(query_id);
+  }
+  try_stop();
+}
