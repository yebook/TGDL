# Disposable native verifier. These fixture binaries never enter the native bundle.
# First build production targets build/native from deploy/bot-api/Dockerfile.
ARG TGDL_BUILD_IMAGE=tgd-native-http-download-wait-build
ARG TGDL_NATIVE_IMAGE=tgd-native:http-download-wait
FROM ${TGDL_BUILD_IMAGE} AS fixture
RUN command -v python3 || (apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*)
COPY deploy/bot-api/prepare-http-timeout-fixture.py /verification/prepare.py
RUN python3 /verification/prepare.py && cmake --build /src/build --parallel 2 && \
    cp /src/build/telegram-bot-api /verification/patched && \
    python3 /verification/prepare.py --previous-cap && cmake --build /src/build --parallel 2 && \
    cp /src/build/telegram-bot-api /verification/previous-cap && \
    python3 /verification/prepare.py --baseline && cmake --build /src/build --parallel 2 && \
    cp /src/build/telegram-bot-api /verification/baseline
FROM ${TGDL_NATIVE_IMAGE}
COPY --from=fixture /verification/patched /verification/previous-cap /verification/baseline /verification/
COPY deploy/bot-api/verify-native-transport.py deploy/bot-api/verify-native-http-timeout.py /verification/
ENTRYPOINT ["python3", "/verification/verify-native-http-timeout.py"]
