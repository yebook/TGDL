+namespace {
+class TgdCacheHash final : public Actor {
+ public:
+  TgdCacheHash(string root, string path, int64 size, string sha256, Promise<std::shared_ptr<TgdCacheProof>> promise)
+      : root_(std::move(root)), path_(std::move(path)), expected_(std::move(sha256)), size_(size), promise_(std::move(promise)) {}
+ private:
+  string root_, path_, expected_;
+  int64 size_, read_ = 0;
+  std::shared_ptr<TgdCacheProof> proof_;
+  Promise<std::shared_ptr<TgdCacheProof>> promise_;
+  EVP_MD_CTX *hash_ = nullptr;
+  std::array<char, 1024 * 1024> buffer_;
+  void fail(const char *message) { promise_.set_error(409, string(message)); stop(); }
+  void start_up() final {
+    proof_ = TgdCacheProof::open(root_, path_, size_);
+    if (!proof_) return fail("TGD_CACHE_RECOVERY_IDENTITY");
+    hash_ = EVP_MD_CTX_new();
+    if (!hash_ || EVP_DigestInit_ex(hash_, EVP_sha256(), nullptr) != 1) return fail("TGD_CACHE_RECOVERY_UNAVAILABLE");
+    yield();
+  }
+  void loop() final {
+    auto count = ::read(proof_->fd, buffer_.data(), buffer_.size());
+    if (count < 0 && errno == EINTR) { yield(); return; }
+    if (count < 0 || read_ + count > size_) return fail("TGD_CACHE_RECOVERY_IDENTITY");
+    if (count) {
+      read_ += count;
+      if (EVP_DigestUpdate(hash_, buffer_.data(), static_cast<std::size_t>(count)) != 1)
+        return fail("TGD_CACHE_RECOVERY_UNAVAILABLE");
+      yield(); // Bounded memory/work per actor turn; never block the Client actor.
+      return;
+    }
+    unsigned char digest[EVP_MAX_MD_SIZE];
+    unsigned int length = 0;
+    if (read_ != size_ || !proof_->matches()) return fail("TGD_CACHE_RECOVERY_IDENTITY");
+    if (EVP_DigestFinal_ex(hash_, digest, &length) != 1 || length != 32)
+      return fail("TGD_CACHE_RECOVERY_UNAVAILABLE");
+    string actual;
+    const char *hex = "0123456789abcdef";
+    for (unsigned int i = 0; i < length; ++i) { actual += hex[digest[i] >> 4]; actual += hex[digest[i] & 15]; }
+    if (actual != expected_) return fail("TGD_CACHE_RECOVERY_CONTENT");
+    promise_.set_value(std::move(proof_));
+    stop();
+  }
+  void tear_down() final { if (hash_) EVP_MD_CTX_free(hash_); }
+};
+}
+
+void FileLoadManager::tgd_verify_cache(string root, string path, int64 size, string sha256,
+                                        Promise<std::shared_ptr<TgdCacheProof>> promise) {
+  create_actor<TgdCacheHash>("TgdCacheHash", std::move(root), std::move(path), size,
+                              std::move(sha256), std::move(promise)).release();
+}
+
 void FileLoadManager::unlink_file(string file_path, Promise<Unit> promise) {
+  tgd_unlink_file(std::move(file_path), std::move(promise), {});
+}
+
+void FileLoadManager::tgd_unlink_file(string file_path, Promise<Unit> promise, std::shared_ptr<TgdCacheProof> proof) {
+  if (proof && (proof->path != file_path || !proof->matches()))
+    return promise.set_error(409, "TGD_CACHE_RECOVERY_IDENTITY");
+  if (proof) {
+    // TDLib still owns this deletion. Use the retained verified media-directory
+    // descriptor so an ancestor rename cannot redirect the final mutation.
+    if (::unlinkat(proof->parent, proof->name.c_str(), 0) != 0)
+      return promise.set_error(500, "TGD_CACHE_RECOVERY_UNAVAILABLE");
+    promise.set_value(Unit());
+    return;
+  }
   unlink(file_path).ignore();
   promise.set_value(Unit());
 }
