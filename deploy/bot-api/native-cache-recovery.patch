+bool FileManager::tgd_cache_node_idle(FileNodePtr node) const {
+  if (!node || node->generate_ || node->generate_id_ || node->upload_id_ || node->download_id_ ||
+      node->download_priority_ || node->upload_priority_ || node->generate_priority_ ||
+      node->is_download_started_ || tgd_has_download_worker(node, true)) return false;
+  for (auto id : node->file_ids_) {
+    if (file_download_requests_.count(id) || file_upload_requests_.count(id) ||
+        pending_user_file_downloads_.count(id)) return false;
+  }
+  return true;
+}
+
+void FileManager::tgd_recover_file_cache(FileId alias, string path, int64 size, string sha256, Promise<Unit> promise) {
+  TRY_STATUS_PROMISE(promise, G()->close_status());
+  auto node = get_sync_file_node(alias);
+  if (!node || !tgd_cache_node_idle(node)) return promise.set_error(409, "TGD_CACHE_RECOVERY_BUSY");
+  FileView view(node);
+  // Derive the media directory from the offline remote ID, never from the path.
+  if (node->local_.type() != LocalFileLocation::Type::Empty || !view.has_full_remote_location() ||
+      size <= 0 || sha256.size() != 64) return promise.set_error(409, "TGD_CACHE_RECOVERY_IDENTITY");
+  for (auto c : sha256) if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+    return promise.set_error(409, "TGD_CACHE_RECOVERY_IDENTITY");
+  auto type = view.get_type();
+  if (type == FileType::None || type == FileType::Size)
+    return promise.set_error(409, "TGD_CACHE_RECOVERY_IDENTITY");
+  auto kind = get_file_type_class(type);
+  if (kind == FileTypeClass::Temp || kind == FileTypeClass::Encrypted || kind == FileTypeClass::Secure ||
+      type == FileType::None || type == FileType::Size)
+    return promise.set_error(409, "TGD_CACHE_RECOVERY_IDENTITY");
+  auto done = PromiseCreator::lambda([self = actor_id(this), alias, path, size, type,
+                                      promise = std::move(promise)](Result<std::shared_ptr<TgdCacheProof>> result) mutable {
+    send_closure(self, &FileManager::tgd_cache_verified, alias, std::move(path), size, type,
+                 std::move(result), std::move(promise));
+  });
+  send_closure(file_load_manager_, &FileLoadManager::tgd_verify_cache, get_files_dir(type), path, size,
+               std::move(sha256), std::move(done));
+}
+
+void FileManager::tgd_cache_verified(FileId alias, string path, int64 size, FileType type,
+                                     Result<std::shared_ptr<TgdCacheProof>> result, Promise<Unit> promise) {
+  TRY_STATUS_PROMISE(promise, G()->close_status());
+  TRY_RESULT_PROMISE(promise, proof, std::move(result));
+  auto alias_node = get_sync_file_node(alias);
+  if (!tgd_cache_node_idle(alias_node)) return promise.set_error(409, "TGD_CACHE_RECOVERY_BUSY");
+  if (alias_node->local_.type() != LocalFileLocation::Type::Empty || alias_node->get_type() != type || !proof->matches())
+    return promise.set_error(409, "TGD_CACHE_RECOVERY_IDENTITY");
+  auto info = check_full_local_location({FullLocalFileLocation(type, path, 0), size}, true);
+  if (info.is_error() || info.ok().location_.path_ != path || info.ok().location_.file_type_ != type || !proof->matches())
+    return promise.set_error(409, "TGD_CACHE_RECOVERY_IDENTITY");
+  auto location = info.ok().location_;
+  // All historical entries for this pathname must be idle; stale index entries
+  // survive delete_file's drop_local_location even if its async unlink failed.
+  for (const auto &entry : local_location_to_file_id_) {
+    if (entry.first.path_ == path && entry.second.is_valid()) {
+      auto owner = get_sync_file_node(entry.second);
+      if (!tgd_cache_node_idle(owner)) return promise.set_error(409, "TGD_CACHE_RECOVERY_BUSY");
+      if (owner->local_.type() != LocalFileLocation::Type::Empty &&
+          (owner->local_.type() != LocalFileLocation::Type::Full || owner->local_.full() != location))
+        return promise.set_error(409, "TGD_CACHE_RECOVERY_IDENTITY");
+    }
+  }
+  FileId recovery_id;
+  // This continuation is synchronous on FileManager. Undo only the exact full
+  // location introduced here if any later proof/registration check rejects it.
+  // Otherwise a restored remote alias could bypass content proof on its retry.
+  auto reject_registration = [&](const char *reason) {
+    if (recovery_id.is_valid()) {
+      auto transient = get_file_node(recovery_id);
+      if (transient && transient->local_.type() == LocalFileLocation::Type::Full &&
+          transient->local_.full() == location) {
+        transient->drop_local_location();
+        try_flush_node(transient, "tgd_cache_recovery_rollback");
+      }
+    }
+    promise.set_error(409, string(reason));
+  };
+  auto found = local_location_to_file_id_.find(location);
+  const bool had_registration = found != local_location_to_file_id_.end() && found->second.is_valid();
+  if (found != local_location_to_file_id_.end() && found->second.is_valid()) {
+    auto stale = get_sync_file_node(found->second);
+    if (stale->local_.type() == LocalFileLocation::Type::Empty) {
+      // Restore only this exact idle mapping. Do not allocate a new FileId on
+      // every failed unlink and never merge a local-only registration into alias.
+      if (stale->size_ != size) return promise.set_error(409, "TGD_CACHE_RECOVERY_IDENTITY");
+      recovery_id = found->second;
+      stale->set_local_location(LocalFileLocation(location), -1, -1);
+      try_flush_node(stale, "tgd_cache_recovery");
+    }
+  }
+  auto registered = register_local(location, DialogId(), size, false, true);
+  if (registered.is_error()) return reject_registration("TGD_CACHE_RECOVERY_IDENTITY");
+  auto id = registered.move_as_ok();
+  if (!had_registration) recovery_id = id;
+  if (!proof->matches()) return reject_registration("TGD_CACHE_RECOVERY_IDENTITY");
+  auto local = get_file_view(id);
+  if (!tgd_cache_node_idle(get_sync_file_node(id)) || !local.has_full_local_location() ||
+      *local.get_full_local_location() != location || local.size() != size || !local.can_delete())
+    return reject_registration("TGD_CACHE_RECOVERY_IDENTITY");
+  delete_file_with_proof(id, std::move(promise), "tgd_cache_recovery", std::move(proof));
+}
