# Disposable storage-worker verification. Never used as a production base.
ARG TGDL_BUILD_IMAGE=tgd-native-cache-storage-build
ARG TGDL_NATIVE_IMAGE=tgd-native:cache-storage
ARG TGDL_TOOLS_IMAGE=verification-tools
FROM ${TGDL_BUILD_IMAGE} AS fixture
COPY deploy/bot-api/prepare-cache-storage-fixture.py /verification/prepare-cache-storage.py
RUN python3 /verification/prepare-cache-storage.py && cmake --build /src/build --parallel 2 && cp /src/build/telegram-bot-api /verification/cache-storage-fixture
FROM ${TGDL_NATIVE_IMAGE} AS production
FROM ${TGDL_NATIVE_IMAGE} AS verification-tools
USER root
RUN apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends strace g++ && rm -rf /var/lib/apt/lists/*
FROM ${TGDL_TOOLS_IMAGE}
USER root
COPY --from=production /usr/local/bin/telegram-bot-api /usr/local/bin/telegram-bot-api
COPY deploy/bot-api/CacheCleanup.h deploy/bot-api/test-cache-cleanup.cpp deploy/bot-api/CacheStorage.h deploy/bot-api/test-cache-storage.cpp /verification/
RUN g++ -std=c++17 -Wall -Wextra -Werror /verification/test-cache-cleanup.cpp -o /verification/test-cache-cleanup && /verification/test-cache-cleanup && g++ -std=c++17 -Wall -Wextra -Werror /verification/test-cache-storage.cpp -o /verification/test-cache-storage && /verification/test-cache-storage
COPY --from=fixture /verification/cache-storage-fixture /verification/
COPY deploy/bot-api/verify-native-transport.py deploy/bot-api/verify-native-cache-cleanup.py deploy/bot-api/verify-native-cache-storage.py /verification/
USER 1000:1000
ENTRYPOINT ["python3", "/verification/verify-native-cache-storage.py"]
