# Disposable verifier only; never used in the deployment topology.
ARG TGDL_API_IMAGE=tgd-bot-api-source:0.1.1
FROM ${TGDL_API_IMAGE}
USER root
RUN apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends strace g++ && rm -rf /var/lib/apt/lists/*
COPY deploy/bot-api/CacheCleanup.h deploy/bot-api/test-cache-cleanup.cpp /verification/
RUN g++ -std=c++17 -Wall -Wextra -Werror /verification/test-cache-cleanup.cpp -o /verification/test-cache-cleanup && /verification/test-cache-cleanup
COPY deploy/bot-api/verify-native-transport.py deploy/bot-api/verify-native-cache-cleanup.py /verification/
ENTRYPOINT ["python3", "/verification/verify-native-cache-cleanup.py"]
