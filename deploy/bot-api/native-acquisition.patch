+namespace {
+struct TgdAcquisitionReply final : td::Jsonable {
+  td::string generation;
+  td::string id;
+  AcquisitionControl::Owner owner;
+  TgdAcquisitionReply(td::string g, td::string i, const AcquisitionControl::Owner &o)
+      : generation(std::move(g)), id(std::move(i)), owner(o) {}
+  void store(td::JsonValueScope *scope) const {
+    auto o = scope->enter_object();
+    o("generation", generation);
+    o("acquisition_id", id);
+    o("state", AcquisitionControl::name(owner.state));
+    o("settled", td::JsonBool(owner.settled));
+  }
+};
