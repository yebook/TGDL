+
+void Client::tgd_acquisition_settle(const td::string &id, AcquisitionControl::State state) {
+  auto *owner = tgd_acquisitions_.get(id);
+  if (!owner) return;
+  owner->state = state;
+  owner->settled = true;
+  owner->touched = td::Time::now();
+}
+
+void Client::tgd_acquisition_control(PromisedQueryPtr query) {
+  const char *generation = std::getenv("TGD_PROGRESS_GENERATION");
+  if (!parameters_->local_mode_ || !was_authorized_ || closing_ || logging_out_ ||
+      !generation || !*generation || td::Slice(generation).size() > 128) {
+    return fail_query(404, "Not Found: acquisition control unavailable", std::move(query));
+  }
+  auto expected = query->arg("generation");
+  if (expected.empty() || expected.size() > 128 || !query->files().empty()) {
+    return fail_query(400, "Bad Request: invalid acquisition request", std::move(query));
+  }
+  if (expected != td::Slice(generation)) {
+    return fail_query(409, "Conflict: acquisition generation changed", std::move(query));
+  }
+  tgd_acquisitions_.prune(td::Time::now());
+  td::string id = query->arg("acquisition_id").str();
+  if (query->method() == "tgdpreparefileacquisition") {
+    auto alias = query->arg("file_id").str();
+    if (alias.empty() || alias.size() > 4096 || query->args().size() != 2) {
+      return fail_query(400, "Bad Request: invalid acquisition request", std::move(query));
+    }
+    if (tgd_cache_storage_.busy() || tgd_cache_gate_.busy()) {
+      return fail_query(409, "Conflict: TGD_CACHE_STORAGE_BUSY", std::move(query));
+    }
+    // Never reuse an owner ID. Native-minted registration means delayed getFile
+    // cannot create work once an expired/cancelled token has been retired.
+    do {
+      char random[32];
+      td::Random::secure_bytes(td::MutableSlice(random, sizeof(random)));
+      id = td::hex_encode(td::Slice(random, sizeof(random)));
+    } while (tgd_acquisitions_.get(id));
+    if (!tgd_acquisitions_.prepare(id, alias, td::Time::now())) {
+      return fail_query(409, "Conflict: acquisition capacity reached", std::move(query));
+    }
+  } else {
+    if (id.size() != 64 || query->args().size() != 2 ||
+        id.find_first_not_of("0123456789abcdef") != td::string::npos) {
+      return fail_query(400, "Bad Request: invalid acquisition request", std::move(query));
+    }
+    auto *owner = tgd_acquisitions_.get(id);
+    if (!owner) return fail_query(404, "Not Found: acquisition unavailable", std::move(query));
+    if (query->method() == "tgdcancelfileacquisition" && !owner->settled) {
+      if (owner->file_id == 0) {
+        // The still-pending resolver only reads metadata and rechecks this token.
+        tgd_acquisition_settle(id, AcquisitionControl::State::Cancelled);
+      } else {
+        const auto file_id = owner->file_id;
+        owner->state = AcquisitionControl::State::Cancelling;
+        auto it = file_download_listeners_.find(file_id);
+        if (it != file_download_listeners_.end()) {
+          auto &queries = it->second;
+          for (auto q = queries.begin(); q != queries.end();) {
+            if ((*q)->arg("tgd_acquisition_id") == id) {
+              fail_query(400, "Bad Request: TGD_ACQUISITION_CANCELLED", std::move(*q));
+              q = queries.erase(q);
+            } else ++q;
+          }
+          if (queries.empty()) file_download_listeners_.erase(it);
+        }
+        if (is_file_being_downloaded(file_id)) {
+          // Another owned/legacy same-ID listener owns the continuing transfer.
+          tgd_acquisition_settle(id, AcquisitionControl::State::Cancelled);
+        } else {
+          tgd_acquisition_wait(file_id, id, AcquisitionControl::State::Cancelled);
+        }
+      }
+    }
+  }
+  TgdAcquisitionReply reply(expected.str(), id, *tgd_acquisitions_.get(id));
+  answer_query(reply, std::move(query));
+}
+
+void Client::tgd_acquisition_resolved(td::string id, PromisedQueryPtr query, object_ptr<td_api::Object> result) {
+  auto *owner = tgd_acquisitions_.get(id);
+  if (!owner || owner->state != AcquisitionControl::State::Resolving) {
+    return fail_query(400, "Bad Request: TGD_ACQUISITION_CANCELLED", std::move(query));
+  }
+  if (result->get_id() == td_api::error::ID) {
+    tgd_acquisition_settle(id, AcquisitionControl::State::Failed);
+    return fail_query_with_error(std::move(query), move_object_as<td_api::error>(result));
+  }
+  CHECK(result->get_id() == td_api::file::ID);
+  auto file = move_object_as<td_api::file>(result);
+  if (tgd_cache_storage_.busy() || tgd_cache_gate_.blocks(file->id_) ||
+      tgd_acquisitions_.blocks(file->id_)) {
+    tgd_acquisition_settle(id, AcquisitionControl::State::Failed);
+    return fail_query(400, "Bad Request: TGD_CACHE_CLEANUP_BUSY", std::move(query));
+  }
+  do_get_file(std::move(file), std::move(query));
+}
+
+void Client::tgd_acquisition_wait(int32 file_id, const td::string &id, AcquisitionControl::State state) {
+  auto &file = tgd_acquisitions_.files[file_id];
+  bool found = false;
+  for (auto &waiter : file.waiters) if (waiter.first == id) { waiter.second = state; found = true; }
+  if (!found) file.waiters.emplace_back(id, state);
+  file.stopping = true;  // Exclude new aliases, cleanup and GC immediately.
+  tgd_acquisition_stop(file_id);
+}
+
+void Client::tgd_acquisition_stop(int32 file_id) {
+  auto it = tgd_acquisitions_.files.find(file_id);
+  if (it == tgd_acquisitions_.files.end()) return;
+  auto &file = it->second;
+  // Initial downloadFile may still be checking a partial location asynchronously.
+  // Cancelling before this callback can be a no-op followed by a late new writer.
+  if (!file.stopping || file.starts || file.stop_sent || is_file_being_downloaded(file_id)) return;
+  file.stop_sent = true;
+  send_request(make_object<td_api::tgdCancelDownloadFile>(file_id),
+               td::make_unique<TdOnAcquisitionStoppedCallback>(this, file_id, file.epoch));
+}
+
+void Client::tgd_acquisition_stopped(int32 file_id, td::uint64 epoch, object_ptr<td_api::Object> result) {
+  auto it = tgd_acquisitions_.files.find(file_id);
+  if (it == tgd_acquisitions_.files.end() || it->second.epoch != epoch) return;
+  if (result->get_id() != td_api::file::ID || closing_ || logging_out_) {
+    // Unknown outcome retains gate and nonsettled owners until child replacement.
+    return;
+  }
+  auto file = move_object_as<td_api::file>(result);
+  tgd_cache_storage_.observe_file(file->id_, file->local_->is_downloading_active_, file->remote_->is_uploading_active_);
+  for (const auto &waiter : it->second.waiters) tgd_acquisition_settle(waiter.first, waiter.second);
+  download_started_file_ids_.erase(file_id);
+  tgd_progress_.finish(file_id, td::Time::now(), true);
+  tgd_acquisitions_.files.erase(it);
+}
+
+void Client::tgd_acquisition_started(int32 file_id, td::uint64 epoch, object_ptr<td_api::Object> result) {
+  auto it = tgd_acquisitions_.files.find(file_id);
+  if (it == tgd_acquisitions_.files.end() || it->second.epoch != epoch) return;
+  CHECK(it->second.starts > 0);
+  --it->second.starts;
+  if (result->get_id() == td_api::error::ID) {
+    auto error = move_object_as<td_api::error>(result);
+    on_file_download(file_id, td::Status::Error(error->code_, error->message_));
+  } else {
+    CHECK(result->get_id() == td_api::file::ID);
+    if (is_file_being_downloaded(file_id)) download_started_file_ids_.insert(file_id);
+    on_update_file(move_object_as<td_api::file>(result));
+  }
+  tgd_acquisition_stop(file_id);
+  // Ordinary legacy requests have no owner record; retire their idle start fence.
+  it = tgd_acquisitions_.files.find(file_id);
+  if (it != tgd_acquisitions_.files.end() && !it->second.stopping &&
+      !it->second.starts && !is_file_being_downloaded(file_id)) tgd_acquisitions_.files.erase(it);
+}
