# Copy to .env; never commit real credentials.
# Relative bind paths resolve from the Compose file's directory (project root).
# For an existing NAS share, set the corresponding path to its real host path.
TGD_HOST_DATA=./data
TGD_HOST_DOWNLOADS=./downloads
TGD_HOST_API_CACHE=./bot-api
TGD_HOST_API_CONTROL=./api-control
TGD_HOST_NETWORK=./network
TGD_UID=1000
TGD_GID=1000
# Bind to your NAS LAN IP for LAN access. Loopback is the safe initial default.
TGD_BIND_IP=127.0.0.1
TGD_WEB_PORT=8000
TGD_TIMEZONE=Asia/Shanghai
# Optional legacy fallback: obtain from my.telegram.org, NOT BotFather.
# Prefer configuring API ID / Hash in WebUI. Blank keeps supervisor waiting.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Proxy stack only; choose a subnet which does not overlap LAN/VPN/Docker networks.
TGD_NETWORK_SUBNET=172.30.88.0/24
# Bot token and allowed Telegram user IDs are set in the WebUI after bootstrap.
