# 复制为 .env；切勿提交真实凭据。
# 相对挂载路径以 Compose 文件所在目录（项目根目录）为基准解析。
# 使用已有 NAS 共享时，请将对应路径设为实际的宿主机路径。
TGD_HOST_DATA=./data
TGD_HOST_DOWNLOADS=./downloads
TGD_HOST_API_CACHE=./bot-api
# 运行时用户和用户组的数字 ID（允许为 0）；请确保该用户和组具有目录访问权限。
TGD_UID=1000
TGD_GID=1000
# WebUI 的宿主机端口；请使用 Docker 宿主机地址访问。
TGD_WEB_PORT=8000
TGD_TIMEZONE=Asia/Shanghai
# 私有 API 控制数据卷会自动初始化。
# Bot Token、允许使用的用户 ID、API ID / Hash 和代理均在 WebUI 中配置。

# 仅支持源码部署：docker compose up -d 会构建当前检出的源码。
# 显式从源码编译原生组件时的并行任务数（1–64）；任务数越多，内存需求越高。
TGD_BUILD_JOBS=2
# Compose 使用随源码附带的预编译二进制文件（linux/amd64），无需编译 TDLib。
