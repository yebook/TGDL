# Copy to .env; never commit real credentials.
# Relative bind paths resolve from the Compose file's directory (project root).
# For an existing NAS share, set the corresponding path to its real host path.
TGD_HOST_DATA=./data
TGD_HOST_DOWNLOADS=./downloads
TGD_HOST_API_CACHE=./bot-api
# Numeric runtime user/group IDs (0 allowed); both must have directory access.
TGD_UID=1000
TGD_GID=1000
# WebUI host port; access it using the Docker host's address.
TGD_WEB_PORT=8000
TGD_TIMEZONE=Asia/Shanghai
# Private API control volume initializes automatically.
# Bot token, allowed user IDs, API ID / Hash and proxy are configured in WebUI.

# Optional image overrides (tag or digest); init-volumes always shares TGD_API_IMAGE.
# Leave unset to use the selected Compose file's defaults.
# TGD_APP_IMAGE=ghcr.io/yebook/tgdl-app:0.1.0
# TGD_API_IMAGE=ghcr.io/yebook/tgdl-bot-api:0.1.0
# Source builds only: compiler jobs; more jobs require more memory (1..64).
TGD_BUILD_JOBS=2
# Source builds only: optional project-native image digest; default builds the internal native stage.
# Use only this project's matching patched native image, never a stock Bot API image.
# TGD_NATIVE_IMAGE=native
